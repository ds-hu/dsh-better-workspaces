{
  "name": "@ds-hu/dsh-bw-diff",
  "description": "Right-sidebar 代码变更 page: git diff review, commit/pull/push/PR actions, and the CAS-protected file editor.",
  "version": "0.4.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dependencies": {
    "@ds-hu/dsh-bw-core": "0.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ds-hu/dsh-better-workspaces.git",
    "directory": "packages/diff"
  },
  "license": "MIT",
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSES"
  ]
}
